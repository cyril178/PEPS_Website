---
interface Props {
  eyebrow?: string; title: string; lead?: string;
  image?: { src: string; alt: string; width: number; height: number };
}
const { eyebrow, title, lead, image } = Astro.props;
---
<header class:list={['page-header', { 'has-image': image }]}>
  <div class="glow" aria-hidden="true"></div>
  <div class="wrap inner">
    <div class="text">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h1>{title}</h1>
      {lead && <p class="lead">{lead}</p>}
    </div>
    {image && (
      <figure class="art">
        <img src={image.src} alt={image.alt} width={image.width} height={image.height} />
      </figure>
    )}
  </div>
</header>

<style>
  .page-header {
    position: relative; overflow: hidden;
    padding: clamp(2.5rem, 6vw, 4.5rem) 0 clamp(2rem, 4vw, 3rem);
    background: var(--surface); border-bottom: 1px solid var(--line); margin-bottom: 2.5rem;
  }
  .glow {
    position: absolute; inset: -40% -10% auto auto; width: 60vw; height: 60vw; max-width: 720px; max-height: 720px;
    background: radial-gradient(closest-side, rgb(43 93 104 / 0.10), transparent);
    pointer-events: none;
  }
  .inner { position: relative; display: grid; gap: 2rem; align-items: center; }
  .has-image .inner { grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); }
  h1 { max-width: 20ch; }
  .lead { font-size: 1.2em; max-width: 52ch; color: var(--ink-soft); margin: 0; }
  .art { margin: 0; }
  .art img {
    display: block; width: 100%; height: auto; border-radius: calc(var(--radius) * 2);
    background: #fff; box-shadow: 0 24px 60px -30px rgb(28 61 69 / 0.45);
  }
  @media (max-width: 760px) {
    .has-image .inner { grid-template-columns: 1fr; }
    .art img { max-width: 560px; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .text, .art { animation: rise 0.7s cubic-bezier(.2,.7,.2,1) both; }
    .art { animation-delay: 0.12s; }
    @keyframes rise { from { opacity: 0; transform: translateY(14px); } }
  }
</style>
