---
// Frise verticale du parcours du·de la participant·e (mobile d'abord).
interface Props { steps: { title: string; text: string }[] }
const { steps } = Astro.props;
---
<ol class="journey" style={`--n:${steps.length}`}>
  {steps.map((s, i) => (
    <li>
      <span class="num" aria-hidden="true">{i + 1}</span>
      <div>
        <strong>{s.title}</strong>
        <p>{s.text}</p>
      </div>
    </li>
  ))}
</ol>

<style>
  .journey { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; max-width: var(--measure); }
  li { position: relative; display: grid; grid-template-columns: 2.75rem 1fr; gap: 1rem; padding-bottom: 1.5rem; }
  li:not(:last-child)::before {
    content: ''; position: absolute; left: calc(1.375rem - 1.5px); top: 2.75rem; bottom: 0.25rem;
    width: 3px; border-radius: 3px; background: var(--sun-soft);
  }
  .num {
    display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 50%;
    background: var(--teal); color: #fff; font-weight: 700; font-size: 1.1rem;
  }
  li:last-child .num { background: var(--sun); color: var(--teal-deep); }
  strong { display: block; font-family: var(--font-display); font-weight: 560; font-size: 1.25rem; color: var(--teal-deep); padding-top: 0.45rem; }
  p { margin: 0.2rem 0 0; color: var(--ink-soft); }

  @media (min-width: 900px) {
    .journey { max-width: none; grid-template-columns: repeat(var(--n, 5), 1fr); gap: 1rem; }
    li { grid-template-columns: 1fr; gap: 0.6rem; padding-bottom: 0; align-content: start; }
    li:not(:last-child)::before { left: 2.75rem; right: -1rem; top: calc(1.375rem - 1.5px); bottom: auto; width: auto; height: 3px; }
    strong { padding-top: 0; }
  }
</style>
