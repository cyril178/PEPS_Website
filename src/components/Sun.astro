---
// Motif « lever de soleil » : l'identité visuelle de PEPS (émotions positives).
interface Props { size?: number; class?: string; horizon?: string }
const { size = 40, class: cls, horizon = 'var(--teal)' } = Astro.props;
---
<svg class={cls} width={size} height={size} viewBox="0 0 48 48" aria-hidden="true" focusable="false">
  <path d="M13 34a11 11 0 0 1 22 0z" fill="var(--sun)" />
  <g stroke="var(--sun)" stroke-width="3" stroke-linecap="round">
    <line x1="24" y1="9" x2="24" y2="15" />
    <line x1="9.5" y1="16.5" x2="13.7" y2="20.7" />
    <line x1="38.5" y1="16.5" x2="34.3" y2="20.7" />
    <line x1="3" y1="29" x2="8" y2="29" />
    <line x1="40" y1="29" x2="45" y2="29" />
  </g>
  <line x1="4" y1="37" x2="44" y2="37" stroke={horizon} stroke-width="3" stroke-linecap="round" />
</svg>
