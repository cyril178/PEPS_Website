---
// Vidéo sans aucun contact avec YouTube depuis ce site :
// - fichier local (src) → lecteur intégré ;
// - YouTube → simple lien qui ouvre la vidéo sur youtube.com dans un nouvel onglet.
// Aucune image, aucun script ni cookie de YouTube n'est chargé ici.
import site from '../data/site.json';
interface Props { youtube?: string; src?: string; poster?: string; caption: string }
const { youtube, src, poster = '/images/peps-illustration.jpg', caption } = Astro.props;
---
<figure class="video">
  {src ? (
    <video controls preload="metadata" poster={poster} src={src}>
      <track kind="captions" srclang="fr" label="Français" src={src.replace(/\.\w+$/, '.vtt')} default />
    </video>
  ) : youtube ? (
    <a class="facade" href={`https://www.youtube.com/watch?v=${youtube}`} target="_blank" rel="noopener noreferrer"
      style={`background-image:url(${poster})`} aria-label={`Regarder la vidéo sur YouTube : ${caption}`}>
      <span class="veil" aria-hidden="true"></span>
      <span class="play" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="34" height="34"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
      </span>
      <span class="note">Regarder sur YouTube (nouvel onglet)</span>
    </a>
  ) : (
    <div class="placeholder">
      <span>{site.draft ? 'Vidéo — à ajouter (identifiant YouTube ou fichier dans public/videos/)' : 'Vidéo bientôt disponible'}</span>
    </div>
  )}
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .video { margin: 0 0 2.5rem; }
  video, .facade, .placeholder {
    display: block; width: 100%; aspect-ratio: 16 / 9; border: 0; border-radius: calc(var(--radius) * 2); background: var(--surface-2);
  }
  .facade {
    position: relative; overflow: hidden; background-size: contain; background-repeat: no-repeat; background-position: center;
    background-color: #fff; display: grid; place-items: center; text-decoration: none; box-shadow: 0 0 0 1px var(--line);
  }
  .veil { position: absolute; inset: 0; background: linear-gradient(180deg, rgb(28 61 69 / 0.05), rgb(28 61 69 / 0.35)); transition: background 0.25s; }
  .facade:hover .veil { background: linear-gradient(180deg, rgb(28 61 69 / 0.1), rgb(28 61 69 / 0.5)); }
  .play {
    position: relative; display: grid; place-items: center; width: 84px; height: 84px; border-radius: 50%;
    background: var(--teal); color: #fff; box-shadow: 0 10px 30px rgb(0 0 0 / 0.25); transition: transform 0.2s;
  }
  .facade:hover .play { transform: scale(1.07); }
  .note {
    position: absolute; bottom: 0.9rem; left: 50%; transform: translateX(-50%);
    background: rgb(0 0 0 / 0.65); color: #fff; font-size: 0.85rem; padding: 0.3rem 0.8rem; border-radius: 999px; white-space: nowrap;
  }
  .placeholder {
    display: grid; place-items: center; text-align: center; padding: 1rem;
    border: 2px dashed var(--line); color: var(--ink-soft);
  }
  .placeholder span { background: var(--paper); padding: 0.4rem 0.8rem; border-radius: 8px; }
  figcaption { margin-top: 0.6rem; font-size: 0.92rem; color: var(--ink-soft); }
</style>
