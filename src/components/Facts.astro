---
import Icon from './Icon.astro';
interface Props { facts: { label: string; value: string; icon?: string }[]; title?: string }
const { facts, title = 'En bref' } = Astro.props;
---
<section class="facts reveal" aria-label={title}>
  <dl>
    {facts.map((f) => (
      <div>
        {f.icon && <span class="fi"><Icon name={f.icon as any} size={22} /></span>}
        <dt>{f.label}</dt>
        <dd>{f.value}</dd>
      </div>
    ))}
  </dl>
</section>

<style>
  dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 0.75rem;
    margin: 0;
  }
  dl > div {
    background: var(--paper); border: 1px solid var(--line); border-radius: calc(var(--radius) * 1.5);
    padding: 1.1rem 1.25rem; transition: border-color 0.2s, transform 0.2s;
  }
  dl > div:hover { border-color: var(--teal); transform: translateY(-2px); }
  .fi { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 10px; background: var(--sun-soft); color: var(--teal); margin-bottom: 0.7rem; }
  dt { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; color: var(--teal); }
  dd { margin: 0.25rem 0 0; font-size: 1.02rem; line-height: 1.45; }
</style>
