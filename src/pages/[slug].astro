---
// Toutes les pages de src/content/pages/ sauf l'accueil et le contact (pages dédiées).
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Facts from '../components/Facts.astro';
import Video from '../components/Video.astro';
import site from '../data/site.json';

export async function getStaticPaths() {
  const pages = await getCollection('pages', (p) => !['accueil', 'contact'].includes(p.id));
  return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { Content } = await render(page);
const { title, description, eyebrow, facts, video, cta } = page.data;
---
<Base title={title} description={description}>
  <PageHeader eyebrow={eyebrow} title={title} lead={description} />
  <div class="wrap">
    {facts && <div class="facts-block"><Facts facts={facts} /></div>}
    {video && <div class="video-block"><Video {...video} youtube={video.youtube || undefined} /></div>}
    <article class="prose">
      <Content />
    </article>
    {cta && (
      <aside class="cta">
        <p>Une question, ou envie de participer ? Un premier échange ne vous engage à rien.</p>
        <a class="button" href={cta.href}>{cta.label}</a>
      </aside>
    )}
  </div>
</Base>

<style>
  .facts-block { margin-bottom: 2.5rem; }
  .video-block { max-width: 860px; }
  .cta {
    margin-top: 3.5rem; max-width: var(--measure); padding: 1.75rem; border-radius: var(--radius);
    background: var(--sun-soft); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem;
  }
  .cta p { margin: 0; flex: 1 1 280px; font-weight: 700; color: var(--teal-deep); }
</style>
