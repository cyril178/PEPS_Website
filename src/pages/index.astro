---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Facts from '../components/Facts.astro';
import Cards from '../components/Cards.astro';
import StudyFlow from '../components/StudyFlow.astro';
import Icon from '../components/Icon.astro';

const page = await getEntry('pages', 'accueil');
if (!page) throw new Error('src/content/pages/accueil.md manquant');
const { Content } = await render(page);
---
<Base title={page.data.title} description={page.data.description}>
  <section class="hero">
    <div class="blob b1" aria-hidden="true"></div>
    <div class="blob b2" aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div class="hero-text">
        <span class="eyebrow">{page.data.eyebrow}</span>
        <h1>Retrouver l'envie et le <span class="hl">plaisir</span> au quotidien</h1>
        <p class="lead">{page.data.description}</p>
        <div class="actions">
          <a class="button" href="/programme/">Le programme PEPS <Icon name="arrow" size={18} /></a>
          <a class="button ghost" href="/participer/">Déroulement de l'étude</a>
        </div>
      </div>
      <figure class="hero-art">
        <img src="/images/peps-illustration.jpg" width="1400" height="839" alt="Illustration : un groupe réuni autour de deux animateurs. L'un balaie un nuage gris de pensées sombres, l'autre montre une bulle pleine de fleurs et de papillons." />
      </figure>
    </div>
  </section>

  {page.data.facts && <div class="wrap facts-block"><Facts facts={page.data.facts} /></div>}

  <section class="wrap intro">
    <div class="prose reveal"><Content /></div>
    <Cards items={[
      { icon: 'group', title: 'Le programme PEPS', text: '8 séances de groupe pour apprendre à savourer et anticiper les bons moments.', href: '/programme/', more: 'Découvrir le programme' },
      { icon: 'brain', title: 'Pourquoi cette étude ?', text: "Le manque de motivation, et ce que l'IRM peut nous apprendre.", href: '/pourquoi/', more: "Voir l'explication" },
      { icon: 'scan', title: "L'IRM", text: 'Comment se passe une séance, la sécurité, ce qu’il faut savoir avant de venir.', href: '/irm/', more: "Tout sur l'IRM" },
    ]} />
  </section>

  <section class="band" aria-labelledby="deroulement">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">Environ 4 mois</span>
        <h2 id="deroulement">Le déroulement de l'étude</h2>
        <p>Un tirage au sort répartit les participant·es en deux groupes. Tout le monde fait les mêmes mesures au début et à la fin.</p>
      </div>
      <StudyFlow variant="patients" />
      <p class="reveal"><a class="link-arrow" href="/participer/">Toutes les informations sur le déroulement <Icon name="arrow" size={16} /></a></p>
    </div>
  </section>

  <section class="wrap video-band reveal">
    <a class="video-card" href="/programme/#video">
      <span class="play" aria-hidden="true"><svg viewBox="0 0 24 24" width="30" height="30"><path d="M8 5v14l11-7z" fill="currentColor" /></svg></span>
      <span class="vc-text">
        <span class="eyebrow">En vidéo</span>
        <strong>Le programme PEPS en vidéo</strong>
        <span>3 minutes pour découvrir les émotions positives et ce que l'on apprend en groupe.</span>
      </span>
    </a>
  </section>

  <section class="wrap paths reveal" aria-label="Autres participant·es">
    <a class="card-link volunteer" href="/controles/">
      <span class="icon-badge"><Icon name="user" /></span>
      <strong>Participant·es en bonne santé</strong>
      <p>Le groupe de comparaison : un entretien et une IRM, deux fois, à 8 semaines d'intervalle.</p>
      <span class="more">Informations pour les volontaires <Icon name="arrow" size={16} /></span>
    </a>
  </section>
</Base>

<style>
  .hero {
    position: relative; overflow: hidden;
    padding: clamp(3rem, 8vw, 6rem) 0 clamp(5rem, 9vw, 7rem);
    background: linear-gradient(180deg, var(--surface), #eef3f4);
  }
  .blob { position: absolute; border-radius: 50%; filter: blur(60px); opacity: 0.55; pointer-events: none; }
  .b1 { width: 420px; height: 420px; right: -80px; top: -120px; background: rgb(43 93 104 / 0.22); }
  .b2 { width: 320px; height: 320px; left: 30%; bottom: -200px; background: rgb(120 170 180 / 0.28); }
  @media (prefers-reduced-motion: no-preference) {
    .b1 { animation: drift 18s ease-in-out infinite alternate; }
    .b2 { animation: drift 22s ease-in-out infinite alternate-reverse; }
    @keyframes drift { to { transform: translate(-40px, 30px) scale(1.08); } }
    .hero-text > * { animation: rise 0.8s cubic-bezier(.2,.7,.2,1) both; }
    .hero-text > :nth-child(2) { animation-delay: 0.08s; }
    .hero-text > :nth-child(3) { animation-delay: 0.16s; }
    .hero-text > :nth-child(4) { animation-delay: 0.24s; }
    .hero-art { animation: rise 0.9s 0.2s cubic-bezier(.2,.7,.2,1) both; }
    .hero-art img { animation: float 7s ease-in-out 1.2s infinite alternate; }
    .hl::after { animation: underline 0.9s 0.6s cubic-bezier(.2,.7,.2,1) both; }
    @keyframes rise { from { opacity: 0; transform: translateY(16px); } }
    @keyframes float { to { transform: translateY(-8px); } }
    @keyframes underline { from { transform: scaleX(0); } }
  }

  .hero-grid { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); align-items: center; gap: clamp(2rem, 5vw, 4rem); }
  .hero h1 { max-width: 15ch; font-size: clamp(2.2rem, 3.6vw + 1rem, 3.6rem); letter-spacing: -0.02em; }
  .hl { position: relative; z-index: 0; white-space: nowrap; }
  .hl::after {
    content: ''; position: absolute; left: -2px; right: -2px; bottom: 0.06em; height: 0.28em; z-index: -1;
    background: rgb(43 93 104 / 0.18); border-radius: 4px; transform-origin: left;
  }
  .lead { font-size: 1.15em; color: var(--ink-soft); max-width: 48ch; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }
  .hero-art { margin: 0; justify-self: center; }
  .hero-art img {
    display: block; width: 100%; max-width: 560px; height: auto; border-radius: 20px; background: #fff;
    padding: 0.75rem; box-shadow: 0 30px 70px -35px rgb(28 61 69 / 0.55), 0 0 0 1px var(--line);
  }
  @media (max-width: 760px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-art img { max-width: 100%; }
  }

  .facts-block { position: relative; margin-top: -3rem; }
  .facts-block :global(dl > div) { box-shadow: 0 16px 36px -24px rgb(28 61 69 / 0.35); }

  .intro { margin-top: clamp(2.5rem, 6vw, 4rem); }
  .intro .prose :global(p) { font-size: 1.08em; }

  .link-arrow { display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 700; }

  .video-band { margin-top: clamp(3rem, 7vw, 5rem); }
  .video-card {
    position: relative; overflow: hidden; display: flex; align-items: center; gap: clamp(1rem, 3vw, 2rem);
    padding: clamp(1.5rem, 4vw, 2.5rem); border-radius: calc(var(--radius) * 2.5); text-decoration: none;
    background: linear-gradient(120deg, var(--teal-deep), var(--teal)); color: #e8f0f1;
  }
  .video-card::before {
    content: ''; position: absolute; right: -10%; top: -60%; width: 50%; aspect-ratio: 1; border-radius: 50%;
    background: radial-gradient(closest-side, rgb(255 255 255 / 0.14), transparent);
  }
  .video-card:hover { color: #fff; }
  .play {
    flex: none; display: grid; place-items: center; width: 4.5rem; height: 4.5rem; border-radius: 50%;
    background: #fff; color: var(--teal-deep); box-shadow: 0 0 0 0 rgb(255 255 255 / 0.4);
    transition: transform 0.25s;
  }
  .video-card:hover .play { transform: scale(1.08); }
  @media (prefers-reduced-motion: no-preference) {
    .play { animation: pulse 2.6s ease-out infinite; }
    @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgb(255 255 255 / 0.35); } 100% { box-shadow: 0 0 0 22px rgb(255 255 255 / 0); } }
  }
  .vc-text { position: relative; display: flex; flex-direction: column; gap: 0.2rem; }
  .vc-text .eyebrow { color: #cfe1e4; margin: 0; }
  .vc-text strong { font-size: clamp(1.2rem, 1vw + 1rem, 1.55rem); color: #fff; line-height: 1.25; }

  .paths { margin-top: clamp(2.5rem, 6vw, 4rem); max-width: 640px; }
</style>
