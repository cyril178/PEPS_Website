---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import site from '../data/site.json';

const page = await getEntry('pages', 'contact');
if (!page) throw new Error('src/content/pages/contact.md manquant');
const { Content } = await render(page);
const c = site.contact;
const c2 = site.contact2;
// « 022 … » → « +4122… » pour les liens d'appel
const telOf = (n: string) => n.replace(/[^\d+]/g, '').replace(/^0/, '+41');
---
<Base title={page.data.title} description={page.data.description}>
  <PageHeader eyebrow={page.data.eyebrow} title={page.data.title} />
  <div class="wrap grid">
    <div class="prose"><Content /></div>

    <aside class="card" aria-label="Coordonnées">
      <p class="who"><strong>{c.name}</strong><br /><span>{c.role}</span></p>
      <dl>
        <dt>Téléphone</dt>
        <dd><a href={`tel:${telOf(c.phone)}`}>{c.phone}</a></dd>
        <dt>E-mail</dt>
        <dd><a href={`mailto:${c.email}?subject=${encodeURIComponent('Étude PEPS')}`}>{c.email}</a></dd>
        <dt>Horaires</dt>
        <dd>{c.hours}</dd>
        <dt>Adresse</dt>
        <dd>{c.address}<br /><span class="access">{c.access}</span></dd>
      </dl>
      <p class="who second"><strong>{c2.name}</strong></p>
      <dl>
        <dt>Téléphone</dt>
        <dd><a href={`tel:${telOf(c2.phone)}`}>{c2.phone}</a></dd>
        <dt>E-mail</dt>
        <dd><a href={`mailto:${c2.email}?subject=${encodeURIComponent('Étude PEPS')}`}>{c2.email}</a></dd>
      </dl>
    </aside>
  </div>

  <section class="wrap acces" id="acces" aria-labelledby="acces-titre">
    <h2 id="acces-titre">Venir au Campus Biotech</h2>
    <figure class="photo">
      <img src="/images/campus-biotech.jpg" width="246" height="138" alt="Le bâtiment du Campus Biotech, une grande façade en verre." loading="lazy" />
      <figcaption>Le Campus Biotech</figcaption>
    </figure>
    <dl>
      <div><dt>Adresse</dt><dd>{c.address}</dd></div>
      <div><dt>Bus</dt><dd>Lignes 1, 11 ou 25, arrêt <strong>Jardin Botanique</strong></dd></div>
      <div><dt>Tram</dt><dd>Ligne 15, arrêt <strong>Nations</strong>, puis environ 7 minutes à pied</dd></div>
      <div><dt>Train</dt><dd>Gare de <strong>Genève-Sécheron</strong>, puis environ 8 minutes à pied</dd></div>
    </dl>
    <p><a class="button ghost" href="https://www.google.com/maps/search/?api=1&query=Campus+Biotech%2C+Chemin+des+Mines+9%2C+1202+Gen%C3%A8ve" target="_blank" rel="noopener">Ouvrir dans Google Maps</a></p>
  </section>

  <section class="wrap">
    <a class="volunteer" href="/controles/">
      <strong>Participant·es en bonne santé</strong>
      <span>Informations pour le groupe de comparaison →</span>
    </a>
  </section>
</Base>


<style>
  .grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: 2.5rem; align-items: start; }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; } }
  .card { background: var(--teal); color: #eaf3f2; border-radius: calc(var(--radius) + 4px); padding: 1.75rem; }
  .card a { color: #fff; font-weight: 700; }
  .who { margin-top: 0; }
  .second { margin: 2rem 0 0; padding-top: 1.5rem; border-top: 1px solid rgb(255 255 255 / 0.2); }
  .access { font-size: 0.95rem; color: var(--sun-soft); }
  dd a { overflow-wrap: anywhere; }
  .who strong { font-size: 1.3rem; font-weight: 700; color: #fff; }
  .who span { font-size: 0.95rem; color: var(--sun-soft); }
  dl { margin: 1.25rem 0 0; }
  dt { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; color: var(--sun-soft); margin-top: 1rem; }
  dd { margin: 0.15rem 0 0; font-size: 1.08rem; }
  .acces { max-width: var(--measure); margin-top: 3rem; }
  .acces dl { display: grid; gap: 0.75rem; margin: 1rem 0; }
  .acces dl div { background: var(--surface); border-radius: var(--radius); padding: 0.9rem 1.1rem; }
  .acces dt { color: var(--teal); margin-top: 0; }
  .acces dd { margin: 0.1rem 0 0; }
  .photo { margin: 1rem 0 0; }
  .photo img { display: block; width: 100%; max-width: 360px; height: auto; border-radius: var(--radius); }
  .photo figcaption { font-size: 0.9rem; color: var(--ink-soft); margin-top: 0.4rem; }
  .volunteer {
    display: flex; flex-direction: column; gap: 0.25rem; margin-top: 3.5rem; max-width: var(--measure);
    padding: 1.4rem 1.6rem; border-radius: var(--radius); background: var(--surface); text-decoration: none; color: var(--ink);
  }
  .volunteer strong { color: var(--teal-deep); font-size: 1.1rem; }
  .volunteer span { color: var(--teal); font-weight: 700; }
</style>
