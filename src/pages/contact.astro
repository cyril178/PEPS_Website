---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import site from '../data/site.json';

const page = await getEntry('pages', 'contact');
if (!page) throw new Error('src/content/pages/contact.md manquant');
const { Content } = await render(page);
const c = site.contact;
const c2 = site.contact2;
// « 022 … » → « +4122… » pour les liens d'appel
const telOf = (n: string) => n.replace(/[^\d+]/g, '').replace(/^0/, '+41');
---
<Base title={page.data.title} description={page.data.description}>
  <PageHeader eyebrow={page.data.eyebrow} title={page.data.title} />
  <div class="wrap grid">
    <div class="prose"><Content /></div>

    <aside class="card" aria-label="Coordonnées">
      <p class="who"><strong>{c.name}</strong><br /><span>{c.role}</span></p>
      <dl>
        <dt>Téléphone</dt>
        <dd><a href={`tel:${telOf(c.phone)}`}>{c.phone}</a></dd>
        <dt>E-mail</dt>
        <dd><a href={`mailto:${c.email}?subject=${encodeURIComponent('Étude PEPS')}`}>{c.email}</a></dd>
        <dt>Horaires</dt>
        <dd>{c.hours}</dd>
        <dt>Adresse</dt>
        <dd>{c.address}<br /><span class="access">{c.access}</span></dd>
      </dl>
      <p class="who second"><strong>{c2.name}</strong></p>
      <dl>
        <dt>Téléphone</dt>
        <dd><a href={`tel:${telOf(c2.phone)}`}>{c2.phone}</a></dd>
        <dt>E-mail</dt>
        <dd><a href={`mailto:${c2.email}?subject=${encodeURIComponent('Étude PEPS')}`}>{c2.email}</a></dd>
      </dl>
    </aside>
  </div>

  <section class="wrap form-block" aria-labelledby="ecrire">
    <h2 id="ecrire">Laisser un message</h2>
    <p class="hint">Trois champs, c'est tout. Indiquez simplement comment vous préférez être recontacté·e : téléphone ou e-mail, comme vous voulez.</p>
    <form id="contact-form" action={`mailto:${c.email}`} method="post" enctype="text/plain" data-email={c.email}>
      <label for="f-nom">Votre prénom <span>(ou un pseudonyme)</span></label>
      <input id="f-nom" name="Prénom" autocomplete="given-name" required />

      <label for="f-joindre">Comment vous joindre ? <span>(téléphone ou e-mail)</span></label>
      <input id="f-joindre" name="Pour me joindre" required />

      <label for="f-message">Votre message <span>(facultatif)</span></label>
      <textarea id="f-message" name="Message" rows="4" placeholder="Par exemple : j'aimerais en savoir plus, rappelez-moi le matin."></textarea>

      <button class="button" type="submit">Envoyer</button>
      <p class="small">Votre programme d'e-mail s'ouvre avec le message prêt à partir. Rien n'est enregistré sur ce site.</p>
    </form>
  </section>

  <section class="wrap">
    <a class="volunteer" href="/controles/">
      <strong>Vous n'avez pas de trouble psychiatrique ?</strong>
      <span>Devenez volontaire sain·e pour l'étude →</span>
    </a>
  </section>
</Base>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const body = [...data.entries()].map(([k, v]) => `${k} : ${v}`).join('\n');
    window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent('Étude PEPS — message du site')}&body=${encodeURIComponent(body)}`;
  });
</script>

<style>
  .grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: 2.5rem; align-items: start; }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; } }
  .card { background: var(--teal); color: #eaf3f2; border-radius: calc(var(--radius) + 4px); padding: 1.75rem; }
  .card a { color: #fff; font-weight: 700; }
  .who { margin-top: 0; }
  .second { margin: 2rem 0 0; padding-top: 1.5rem; border-top: 1px solid rgb(255 255 255 / 0.2); }
  .access { font-size: 0.95rem; color: var(--sun-soft); }
  dd a { overflow-wrap: anywhere; }
  .who strong { font-family: var(--font-display); font-size: 1.4rem; font-weight: 560; color: #fff; }
  .who span { font-size: 0.95rem; color: var(--sun-soft); }
  dl { margin: 1.25rem 0 0; }
  dt { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; color: var(--sun-soft); margin-top: 1rem; }
  dd { margin: 0.15rem 0 0; font-size: 1.08rem; }
  .form-block { max-width: var(--measure); }
  .hint { color: var(--ink-soft); }
  form { display: grid; gap: 0.4rem; margin-top: 1.5rem; }
  label { font-weight: 700; color: var(--teal-deep); margin-top: 0.9rem; }
  label span { font-weight: 400; color: var(--ink-soft); }
  input, textarea {
    font: inherit; padding: 0.8rem 1rem; border: 2px solid var(--line); border-radius: 10px; background: #fff; color: var(--ink); width: 100%;
  }
  input:focus, textarea:focus { border-color: var(--teal); outline: none; }
  form .button { justify-self: start; margin-top: 1.25rem; border: 0; font: inherit; font-weight: 700; cursor: pointer; }
  .small { font-size: 0.9rem; color: var(--ink-soft); margin: 0.5rem 0 0; }
  .volunteer {
    display: flex; flex-direction: column; gap: 0.25rem; margin-top: 3.5rem; max-width: var(--measure);
    padding: 1.4rem 1.6rem; border-radius: var(--radius); background: var(--surface); text-decoration: none; color: var(--ink);
  }
  .volunteer strong { color: var(--teal-deep); font-size: 1.1rem; }
  .volunteer span { color: var(--teal); font-weight: 700; }
</style>
